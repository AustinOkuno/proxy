# Copy this file to .env and fill in your key. .env is gitignored, never commit it.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: where settings and chat history are stored.
# Default: Electron's userData folder (~/.config/Proxy on Linux).
# PROXY_DATA_DIR=
